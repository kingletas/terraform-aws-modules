# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

region      = "us-east-1"
name        = "exchange"
environment = "production"

partners = {
  acme = {
    public_keys = { primary = "ssh-ed25519 AAAAC3Nza... acme-integration" }
  }

  globex-readonly = {
    public_keys = { primary = "ssh-ed25519 AAAAC3Nza... globex-pull" }
    read_only   = true
  }
}
