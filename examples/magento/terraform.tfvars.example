# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

region      = "us-east-1"
project     = "storefront"
environment = "staging"
owner       = "webops"

domain_name      = "shop.example.com"
hosted_zone_name = "example.com"

# Built with your PHP version, extensions, the SSM agent and the CloudWatch
# agent baked in. A release is a new AMI and an instance refresh.
ami_id = "ami-0123456789abcdef0"

# Off, because CI should build the AMI. Turn it on where releases are compiled
# in the account.
include_builder = false

# Production overrides almost nothing, because the environment already switches
# multi-AZ, retention, guards and capacity:
#
#   environment = "production"
#   web_capacity = { min = 3, max = 20 }
