# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Generate the certificates with easy-rsa first; see this example's README.

region            = "us-east-1"
name              = "vpn-demo"
vpc_cidr          = "10.20.0.0/16"
client_cidr_block = "10.100.0.0/22"
environment       = "sandbox"

# Read the PEM material from disk rather than pasting it here:
#   terraform apply \
#     -var="server_certificate_body=$(cat pki/issued/server.crt)" \
#     -var="server_private_key=$(cat pki/private/server.key)" \
#     -var="client_root_certificate_body=$(cat pki/issued/client.crt)" \
#     -var="client_root_private_key=$(cat pki/private/client.key)" \
#     -var="certificate_chain=$(cat pki/ca.crt)"
