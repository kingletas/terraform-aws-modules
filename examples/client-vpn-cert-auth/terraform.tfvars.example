# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Generate the certificates with easy-rsa first; see this example's README.

region            = "us-east-1"
name              = "vpn-demo"
vpc_cidr          = "10.20.0.0/16"
client_cidr_block = "10.100.0.0/22"
environment       = "sandbox"

# Do not put certificate material in this file. Export it as environment
# variables instead, as the README shows:
#   export TF_VAR_server_private_key="$(cat pki/private/server.key)"
