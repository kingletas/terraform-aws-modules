# Terraform state and working directories
.terraform/
# Lock files in modules. A module leaves provider selection to its caller;
# examples commit theirs.
modules/*/.terraform.lock.hcl
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files, which carry real values; the committed examples end in .example
*.tfvars
*.tfvars.json
!*.tfvars.example

# Plan output, which contains resolved secrets
*.tfplan
*.tfplan.json
plan.json
plan.out

# Backend configuration for a real account; backend.tf.example is kept
backend.tf
!backend.tf.example

# Certificates and keys
*.pem
*.key
*.crt
*.csr
*.ovpn
*.p12
*.gpg
pki/

# Local scratch output
local.d/

# Editor and OS
.idea/
.vscode/
*.swp
.DS_Store

# Shell scripts are always tracked, even where a global excludes file ignores them
!*.sh
